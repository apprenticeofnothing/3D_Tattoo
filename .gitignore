# Body photos, scans, meshes and exports never go in the repo
*.jpg
*.jpeg
*.png
*.heic
*.glb
*.gltf
*.obj
*.ply
/scans
/exports

# Exception: small synthetic test assets
!/test-assets/**

# Build output and dependencies
node_modules/
dist/

# Pose model and runtime, fetched by scripts/fetch-models.mjs
/public/mediapipe/

